# Sepolia execution RPC. PublicNode is a convenient default for read-only testing.
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ERC-4337 bundler endpoint. Obtain a Sepolia endpoint from your chosen provider.
# Example format varies by provider. Leave unset until you have a real endpoint.
BUNDLER_RPC_URL=

# Required only for EIP-7702 signing. Must be an audited, deployed EIP-7702
# delegate implementation on Sepolia. Never use an arbitrary address.
EIP7702_DELEGATE_ADDRESS=

# Optional override. Keep secrets out of source control.
VAULT_DIR=.vault
